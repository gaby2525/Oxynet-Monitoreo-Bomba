# =============================================================================
# Configuracion de Firebase (Realtime Database)
# -----------------------------------------------------------------------------
# Copiar este archivo a `.env` y completar con los valores de:
#   Consola de Firebase -> Configuracion del proyecto -> Tus apps -> App web
#
# Estas claves son PUBLICAS por diseno (van dentro del bundle del navegador).
# Lo que realmente protege los datos son las Reglas de Seguridad de la RTDB:
# ver `firebase/database.rules.json` y el README.
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=oxynet-monitoreo-bomba.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://oxynet-monitoreo-bomba-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=oxynet-monitoreo-bomba
VITE_FIREBASE_STORAGE_BUCKET=oxynet-monitoreo-bomba.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nodo raiz donde el ESP32 publica los datos.
VITE_DB_ROOT=/bomba_oxigeno

# Umbrales de alarma (opcionales; si se omiten se usan los valores por defecto)
VITE_TENSION_NOMINAL=220
VITE_TENSION_MIN=198
VITE_TENSION_MAX=242
VITE_CORRIENTE_MAX=12
VITE_COSFI_MIN=0.7
# Por debajo de esta potencia (W) se considera que la bomba esta apagada
VITE_POTENCIA_APAGADA=15
