{
  // Reglas de la Realtime Database.
  // Consola de Firebase -> Realtime Database -> pestana "Reglas" -> pegar y publicar.
  //
  // Reemplazar UID_DEL_ESP32 por el UID que aparece en Authentication -> Users,
  // en la fila del usuario del dispositivo.
  "rules": {
    ".read": false,
    ".write": false,

    "bomba_oxigeno": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'UID_DEL_ESP32'",

      "ultima_medicion": {
        ".validate": "newData.hasChildren(['timestamp', 'tension', 'corriente', 'potencia', 'cosfi'])",
        "timestamp": { ".validate": "newData.isNumber() && newData.val() > 1577836800" },
        "tension":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500" },
        "corriente": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
        "potencia":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "cosfi":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
        "kwh":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$otro":     { ".validate": false }
      },

      "historial": {
        // La clave de cada registro es el epoch Unix en segundos.
        "$timestamp": {
          ".validate": "$timestamp.matches(/^[0-9]{10}$/)",
          "v":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500" },
          "i":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
          "p":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "fp":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "$otro": { ".validate": false }
        }
      },

      // Lo que el ESP32 cuenta sobre si mismo: red, senal, IP, uptime.
      // Lo lee el panel; solo el dispositivo lo escribe (regla heredada de arriba).
      "estado_dispositivo": {
        "ssid":          { ".validate": "newData.isString() && newData.val().length <= 64" },
        "rssi":          { ".validate": "newData.isNumber()" },
        "ip":            { ".validate": "newData.isString() && newData.val().length <= 45" },
        "mac":           { ".validate": "newData.isString() && newData.val().length <= 32" },
        "uptime_s":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "firmware":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "intervalo_ms":  { ".validate": "newData.isNumber() && newData.val() > 0" },
        "timestamp":     { ".validate": "newData.isNumber()" },
        "wifi_aplicado": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "pzem_ok":       { ".validate": "newData.isBoolean()" },
        "pzem_fallas":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "pendientes":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$otro":         { ".validate": false }
      },

      // Red que el panel deja preparada para el ESP32.
      //
      // Se puede ESCRIBIR con cualquier sesion iniciada, pero solo el ESP32 puede
      // LEERLA: asi la clave del Wi-Fi no se recupera desde el panel ni desde la
      // consola de nadie que entre a mirar. El dispositivo la copia a su memoria
      // y borra el nodo enseguida.
      "wifi_solicitado": {
        ".read": "auth != null && auth.uid === 'UID_DEL_ESP32'",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['ssid'])",
        "ssid":          { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32" },
        "clave":         { ".validate": "newData.isString() && newData.val().length <= 63" },
        "solicitado_en": { ".validate": "newData.isNumber()" },
        "$otro":         { ".validate": false }
      }
    }
  }
}
